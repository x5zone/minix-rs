#!/bin/sh
# minix-rs /etc/rc — init 在进入 multi-user 前执行的最小启动脚本。
#
# 消费链：init 的 runcom 状态机 exec sh /etc/rc（S42 批五已落
# host.rs 的 argv sh+/etc/rc 装配；C 对位链见 minix3/etc/rc）。
#
# 内容口径：OQ-3 盘上文件面的 /etc 最小集草案（new_edge3 NS8 交付）。
# NK4-C §1.106 起主动验证 18-stage 命令面（echo/ls/cat 为核心）：marker
# 置首确保既有冒烟 gate（test-cmd-smoke.sh 只 grep marker）不受下游命令
# 成败影响；随后 ls/cat 走真实 VFS IPC 腿——ls→getdents(readdir)、
# cat→open+read——是对已修 CDEV/lookup 链之上的文件面命令面端到端检验。
# mount/hostname/rc.d 等扩展项仍待 05-shell 消费方就绪后按需上收。
echo "minix-rs rc: minimal boot script marker"
ls /bin
cat /etc/rc
# NK4-C 续-277/278 目标③：ATF C 测试上机腿。本文件只留桥面哨兵（p1/p2/p3，
# 验裸写/stdio/malloc 地基）；套件 exec 行（/tests/<prog> <tc>）由 xtask 装配
# 时从 ATF_SUITE+minix3 C 源提取并注入 rc 变体（target/image/<arch>/rc.imgrd，
# exit 0 前），判数 manifest 落 target/image/<arch>/atf-plan.txt——单源不在这里
# 手拄两份。未播种的架构报 not found 不致命——尾行 exit 0 固定 rc 返回码，
# init runcom 不因测试腿缺失而回落 SingleUser。串口判据见
# os/qemu-tests/test-atf-aarch64.sh。
/tests/p1
/tests/p2
/tests/p3
exit 0
