#!/bin/sh
# minix-rs /etc/rc — init 在进入 multi-user 前执行的最小启动脚本。
#
# 消费链：init 的 runcom 状态机 exec sh /etc/rc（S42 批五已落
# host.rs 的 argv sh+/etc/rc 装配；C 对位链见 minix3/etc/rc）。
#
# 内容口径：OQ-3 盘上文件面的 /etc 最小集草案（new_edge3 NS8 交付）。
# NK4-C §1.106 起主动验证 18-stage 命令面（echo/ls/cat 为核心）：marker
# 置首确保既有冒烟 gate（test-cmd-smoke.sh 只 grep marker）不受下游命令
# 成败影响；随后 ls/cat 走真实 VFS IPC 腿——ls→getdents(readdir)、
# cat→open+read。口径校正（批次一百二十一盘上实测）：cat→open+read 一条
# 确实到位（rc 自身被读回串口），而 ls→getdents 一条今天回 `ls: /bin: read
# error`——imgrd 根盘的目录读腿未通，见 coordination/TODO-LEDGER-OPEN.md §7
# 同名登记；du 的读数也带着同一处断裂（`du: /etc` + 仅含自身的 `24 /etc`）。
# mount/hostname/rc.d 等扩展项仍待 05-shell 消费方就绪后按需上收。
echo "minix-rs rc: minimal boot script marker"
ls /bin
cat /etc/rc
# 批次一百二十登记的 `du` 盘上读数：du 只读，不受只读 imgrd 根盘门控，是本
# 家族第一个能在真机判读量的命令。`/bin/du /etc` 回一行「块数 TAB /etc」
#（默认无 -a 时只印操数自身），由 test-cmd-smoke*.sh 的 du 断言收。进目次
# 名走绝对路径避开 PATH 假设；未播种该二进制的架构只多一行 not found（同
# /bin/e5-ds 先例），不影响 marker 在前的既有冒烟判据。
/bin/du /etc
# 同一目录再走一遍 `-h`：prstat 的那条 humanize 分支（du.c:266-272），渲染走
# minix3/lib/libc/gen/humanize_number.c 的本树移植件，门判据是「数字+单位字母」打头
# 的那一行（今天的读数 12K）。
/bin/du -h /etc
# 批次一百三十一登记的 `stat` 盘上读数：同一条 `lstat` 腿走三种模板（默认、
# `-l`、`-s`）。形状判据在 test-cmd-smoke*.sh——不写 `-f` 自定义模板是为了避开
# 启动脚本里的引号处理，三种预置形已足够把字段取值、strmode 切片与赋值式渲染
# 三条腿都收到串口上。
/bin/stat /etc/rc
/bin/stat -l /etc/rc
/bin/stat -s /etc/rc
# E5(f) 真机半：DS 数据服务传输链载体（minix-sys DsClient → DS 端点 6）。
# 串口判据逐段 `e5-ds: ...`，计数行 `E5f-LABELS n/12`，末行是 run_qemu.sh
# 惯例的 `### TEST_RESULT: ... ###`；门脚本 os/qemu-tests/test-e5-ds.sh。
# 未播种该二进制的架构（名单真源 xtask `E5_DS_READY`）只多一行 not found，
# 不影响 marker 在前的既有冒烟判据。
/bin/e5-ds
# NK4-C 续-277/278 目标③：ATF C 测试上机腿。本文件只留桥面哨兵（p1/p2/p3，
# 验裸写/stdio/malloc 地基）；套件 exec 行（/tests/<prog> <tc>）由 xtask 装配
# 时从 ATF_SUITE+minix3 C 源提取并注入 rc 变体（target/image/<arch>/rc.imgrd，
# exit 0 前），判数 manifest 落 target/image/<arch>/atf-plan.txt——单源不在这里
# 手拄两份。未播种的架构报 not found 不致命——尾行 exit 0 固定 rc 返回码，
# init runcom 不因测试腿缺失而回落 SingleUser。串口判据见
# os/qemu-tests/test-atf-aarch64.sh。
/tests/p1
/tests/p2
/tests/p3
exit 0
